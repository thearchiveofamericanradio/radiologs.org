{
  "name": "radiologs",
  "compatibility_date": "2026-11-01",
  "account_id": "a2c14adf7a038f169985bbb174ed19e7",
  // The Worker only runs for the agent paths below; everything else is served
  // straight from dist/ as before.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html", "/mcp", "/oauth/*", "/auth.md", "/openapi.json", "/health", "/.well-known/*"]
  },
  "routes": [
    { "pattern": "radiologs.org", "custom_domain": true },
    { "pattern": "www.radiologs.org", "custom_domain": true }
  ]
}
